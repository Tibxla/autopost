# Copier en .env (jamais suivi par git) puis remplir.

# --- Signature de WebDriverAgent (scripts/signer-wda.sh) ---
# Identifiant Apple : facultatif, le script le demande s'il manque. Le mot de passe n'est jamais écrit ici.
APPLE_ID=
# Identifiant du runner WDA sur l'iPhone. Laisser vide : le script en tire un au premier passage et l'écrit ici.
# Ensuite, ne plus le changer (10 identifiants neufs par semaine sur un compte gratuit).
WDA_BUNDLE_ID=

# --- Relais locaux vers WebDriverAgent (127.0.0.1) ---
WDA_PORT_LOCAL=8100
# 9100 est souvent déjà pris sur un serveur (node_exporter) : le flux MJPEG de WDA est relayé ailleurs.
MJPEG_PORT_LOCAL=9110

# --- Garde d'Autocalled : jamais d'action pendant un appel ---
AUTOCALLED_PONT_URL=http://127.0.0.1:3021
# Soit le secret du pont, soit le chemin du .env d'Autocalled où le lire (lecture seule).
AUTOCALLED_PONT_SECRET=
AUTOCALLED_ENV=
